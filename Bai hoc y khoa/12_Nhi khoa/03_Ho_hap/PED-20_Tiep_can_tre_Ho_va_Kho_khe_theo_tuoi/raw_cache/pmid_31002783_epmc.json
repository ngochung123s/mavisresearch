-0001-5502-5975"}},{"fullName":"Narasimhan M","lastName":"Narasimhan","firstName":"Mangala","initials":"M"},{"fullName":"Newcombe P","lastName":"Newcombe","firstName":"Peter","initials":"P"},{"fullName":"Oppenheimer J","lastName":"Oppenheimer","firstName":"John","initials":"J"},{"fullName":"Rosen M","lastName":"Rosen","firstName":"Mark","initials":"M"},{"fullName":"Rubin B","lastName":"Rubin","firstName":"Bruce","initials":"B"},{"fullName":"Russell RJ","lastName":"Russell","firstName":"Richard J","initials":"RJ","authorId":{"type":"ORCID","value":"0000-0002-0195-0812"}},{"fullName":"Ryu JH","lastName":"Ryu","firstName":"Jay H","initials":"JH","authorId":{"type":"ORCID","value":"0000-0002-9576-2272"}},{"fullName":"Singh S","lastName":"Singh","firstName":"Sonal","initials":"S","authorId":{"type":"ORCID","value":"0000-0003-0912-941X"}},{"fullName":"Smith J","lastName":"Smith","firstName":"Jaclyn","initials":"J"},{"fullName":"Smith MP","lastName":"Smith","firstName":"Maeve P","initials":"MP"},{"fullName":"Tarlo SM","lastName":"Tarlo","firstName":"Susan M","initials":"SM","authorId":{"type":"ORCID","value":"0000-0002-4746-5310"}},{"fullName":"Turmel J","lastName":"Turmel","firstName":"Julie","initials":"J"},{"fullName":"Vertigan AE","lastName":"Vertigan","firstName":"Anne E","initials":"AE"},{"fullName":"Weinberger M","lastName":"Weinberger","firstName":"Miles","initials":"M"}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5502-5975"},{"type":"ORCID","value":"0000-0001-5865-489X"},{"type":"ORCID","value":"0000-0001-6351-9991"},{"type":"ORCID","value":"0000-0001-8837-4928"},{"type":"ORCID","value":"0000-0002-0195-0812"},{"type":"ORCID","value":"0000-0002-1331-3706"},{"type":"ORCID","value":"0000-0002-4551-6559"},{"type":"ORCID","value":"0000-0002-4577-8954"},{"type":"ORCID","value":"0000-0002-4746-5310"},{"type":"ORCID","value":"0000-0002-6290-3331"},{"type":"ORCID","value":"0000-0002-9345-4903"},{"type":"ORCID","value":"0000-0002-9576-2272"},{"type":"ORCID","value":"0000-0003-0912-941X"},{"type":"ORCID","value":"0000-0003-2341-2094"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"1","volume":"156","journalIssueId":2836252,"dateOfPublication":"2019 Jul","monthOfPublication":7,"yearOfPublication":2019,"journal":{"medlineAbbreviation":"Chest","title":"Chest","essn":"1931-3543","issn":"0012-3692","isoabbreviation":"Chest","nlmid":"0231335"},"printPublicationDate":"2019-07-01"},"pubYear":"2019","pageInfo":"131-140","abstractText":"<h4>Background</h4>Whether gastroesophageal reflux (GER) or GER disease (GERD) causes chronic cough in children is controversial. Using the Population, Intervention, Comparison, Outcome (PICO) format, we undertook four systematic reviews. For children with chronic cough (> 4-weeks duration) and without underlying lung disease: (1) who do not have gastrointestinal GER symptoms, should empirical treatment for GERD be used? (2) with gastrointestinal GER symptoms, does treatment for GERD resolve the cough? (3) with or without gastrointestinal GER symptoms, what GER-based therapies should be used and for how long? (4) if GERD is suspected as the cause, what investigations and diagnostic criteria best determine GERD as the cause of the cough?<h4>Methods</h4>We used the CHEST Expert Cough Panel's protocol and American College of Chest Physicians (CHEST) methodological guidelines and GRADE (Grading of Recommendations Assessment, Development and Evaluation) framework. Delphi methodology was used to obtain consensus.<h4>Results</h4>Few randomized controlled trials addressed the first two questions and none addressed the other two. The single meta-analysis (two randomized controlled trials) showed no significant difference between the groups (any intervention for GERD vs placebo for cough resolution; OR, 1.14; 95% CI, 0.45-2.93; P = .78). Proton pump inhibitors (vs placebo) caused increased serious adverse events. Qualitative data from existing CHEST cough systematic reviews were consistent with two international GERD guidelines.<h4>Conclusions</h4>The panelists endorsed that: (1) treatment(s) for GERD should not be used when there are no clinical features of GERD; and (2) pediatric GERD guidelines should be used to guide treatment and investigations.","affiliation":"Division of Child Health, Menzies School of Health Research, Darwin, Northern Territory, Australia; Respiratory and Sleep Department, Queensland Children's Hospital, Queensland University of Technology, Brisbane, QLD, Australia. Electronic address: annechang@ausdoctors.net.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["other","Practice Guideline","Journal Article"]},"grantsList":{"grant":[{"agency":"National Health and Medical Research Council","grantId":"1154302","orderIn":0},{"agency":"National Institute for Health Research (NIHR)","grantId":"NIHR200288","orderIn":0},{"agency":"NHLBI NIH HHS","acronym":"HL","grantId":"R01 HL131716","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Gastroesophageal Reflux","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"CO","qualifierName":"complications"},{"majorTopic_YN":"N","abbreviation":"DT","qualifierName":"drug therapy"}]}},{"majorTopic_YN":"N","descriptorName":"Cough","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"ET","qualifierName":"etiology"}]}},{"majorTopic_YN":"N","descriptorName":"Chronic Disease"},{"majorTopic_YN":"N","descriptorName":"Evidence-Based Medicine"},{"majorTopic_YN":"N","descriptorName":"Delphi Technique"},{"majorTopic_YN":"N","descriptorName":"Child"},{"majorTopic_YN":"N","descriptorName":"Randomized Controlled Trials as Topic"},{"majorTopic_YN":"N","descriptorName":"Proton Pump Inhibitors","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AE","qualifierName":"adverse effects"},{"majorTo