      scales: {
        y: { title: { display: true, text: 'Peak velocity (cm/s)' }, beginAtZero: true, suggestedMax: 130 },
        x: { title: { display: true, text: 'Tuổi thai' } }
      }
    }
  });
</script>

<script>
  const ctx4 = document.getElementById('chartTRCauses').getContext('2d');
  new Chart(ctx4, {
    type: 'doughnut',
    data: {
      labels: [
        'Structural (AVSD/VSD) — 40-50%',
        'Myocardial dysfunction (functional) — phần lớn còn lại',
        'Pressure overload',
        'Annular dilatation'
      ],
      datasets: [{
        data: [45, 40, 10, 5],
        backgroundColor: ['#be185d', '#3b82f6', '#f59e0b', '#10b981'],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        title: { display: true, text: 'Phân bố nguyên nhân TR ở T21 quý I (ước tính)', font: { size: 16 } },
        legend: { position: 'bottom' }
      }
    }
  });
</script>

</script>
</body>
</html>