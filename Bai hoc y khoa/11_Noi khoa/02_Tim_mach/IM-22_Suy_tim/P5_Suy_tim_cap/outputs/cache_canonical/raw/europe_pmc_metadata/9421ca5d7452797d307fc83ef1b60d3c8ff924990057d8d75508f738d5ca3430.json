{"version":"6.9","hitCount":1,"request":{"queryString":"EXT_ID:35228416 AND SRC:MED","internalQuery":"EXT_ID:35228416 AND SRC:MED","resultType":"CORE","cursorMark":"*","pageSize":5,"sort":"","synonym":false},"resultList":{"result":[{"id":"35228416","source":"MED","pmid":"35228416","pmcid":"PMC9556244","fullTextIdList":{"fullTextId":["PMC9556244"]},"doi":"10.2169/internalmedicine.8705-21","title":"Heterotopic Gastric Mucosa in Middle Esophagus Complicated with Esophageal Ulcers.","authorString":"Kishimoto K, Shibagaki K, Nonomura S, Sumi S, Fukuda N, Takahashi Y, Kotani S, Okimoto E, Oshima N, Kawashima K, Ishimura N, Ishihara S.","authorList":{"author":[{"fullName":"Kishimoto K","firstName":"Kenichi","lastName":"Kishimoto","initials":"K","authorId":{"type":"ORCID","value":"0000-0002-9689-2829"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}},{"fullName":"Shibagaki K","firstName":"Kotaro","lastName":"Shibagaki","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Endoscopy, Shimane University Hospital, Japan."}]}},{"fullName":"Nonomura S","firstName":"Saya","lastName":"Nonomura","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}},{"fullName":"Sumi S","firstName":"Shohei","lastName":"Sumi","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}},{"fullName":"Fukuda N","firstName":"Naoki","lastName":"Fukuda","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Fukuda Clinic, Japan."}]}},{"fullName":"Takahashi Y","firstName":"Yusuke","lastName":"Takahashi","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}},{"fullName":"Kotani S","firstName":"Satoshi","lastName":"Kotani","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}},{"fullName":"Okimoto E","firstName":"Eiko","lastName":"Okimoto","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}},{"fullName":"Oshima N","firstName":"Naoki","lastName":"Oshima","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Endoscopy, Shimane University Hospital, Japan."}]}},{"fullName":"Kawashima K","firstName":"Kousaku","lastName":"Kawashima","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}},{"fullName":"Ishimura N","firstName":"Norihisa","lastName":"Ishimura","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}},{"fullName":"Ishihara S","firstName":"Shunji","lastName":"Ishihara","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-9689-2829"}]},"journalInfo":{"issue":"18","volume":"61","journalIssueId":3423417,"dateOfPublication":"2022 Sep","monthOfPublication":9,"yearOfPublication":2022,"printPublicationDate":"2022-09-01","journal":{"title":"Internal medicine (Tokyo, Japan)","medlineAbbreviation":"Intern Med","isoabbreviation":"Intern Med","nlmid":"9204241","essn":"1349-7235","issn":"0918-2918"}},"pubYear":"2022","pageInfo":"2735-2740","abstractText":"Heterotopic gastric mucosa (HGM) of esophagus, primarily occurring in cervical esophagus, is usually asymptomatic. A healthy woman (mid-40s) with postprandial heartburn was diagnosed with middle esophageal HGM and esophageal ulcers by esophagogastroduodenoscopy. Using 8-channel pH monitoring, a sensor near the HGM area detected postprandial acid phase (pH 3-4), while areas adjacent to the proximal and distal sensors were neutral, suggesting acid secretion from the HGM. A biopsy showed fundic gland tissue expressing H<sup>+</sup>/K<sup>+</sup>-ATPase and pepsinogen-I. Oral vonoprazan improved the clinical symptoms and endoscopic findings. This is the first report using 8-channel pH monitoring to diagnose extremely rare middle esophageal HGM.","affiliation":"Department of Gastroenterology, Faculty of Medicine, Shimane University, Japan.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Journal Article","case-report"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Gastric Mucosa","meshQualifierList":{"meshQualifier":[{"abbreviation":"PA","qualifierName":"pathology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Esophageal Diseases","meshQualifierList":{"meshQualifier":[{"abbreviation":"DG","qualifierName":"diagnostic imaging","majorTopic_YN":"N"},{"abbreviation":"CO","qualifierName":"complications","majorTopic_YN":"N"},{"abbreviation":"PA","qualifierName":"pathology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Peptic Ulcer","meshQualifierList":{"meshQualifier":[{"abbreviation":"CO","qualifierName":"complications","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Choristoma","meshQualifierList":{"meshQualifier":[{"abbreviation":"CO","qualifierName":"complications","majorTopic_YN":"N"},{"abbreviation":"PA","qualifierName":"pathology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Ulcer","meshQualifierList":{"meshQualifier":[{"abbr